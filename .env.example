# Copy to .env. Replace placeholders locally; NEVER commit .env or real credentials.

# Generic REST provider example
MARKET_DATA_API_TOKEN=replace_me

# Zerodha Kite Connect: API key and valid access token.
# Historical candles require a Kite Connect plan with historical-data access.
KITE_API_KEY=replace_me
KITE_API_SECRET=replace_me
KITE_ACCESS_TOKEN=replace_me

# Groww Trading API access token (normally expires daily).
GROWW_ACCESS_TOKEN=replace_me
